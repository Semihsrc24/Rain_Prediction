# Optional Email Notification Settings (SMTP)
# Copy this file to .env and fill in your own credentials if you want to enable email alerts.
# NEVER commit your real .env file to GitHub.
# Note: Weather forecasting and the 81-city Turkey map use Open-Meteo (no API key needed).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENT_EMAIL=recipient@example.com
